# PraxisWerk (ReWaDo) - Beispiel-Konfiguration
# Kopieren: cp .env.example .env  und Werte anpassen.

# Pflicht: Verbindung zur MySQL-Datenbank
DATABASE_URL=mysql://root:passwort@localhost:3306/praxiswerk

# Pflicht: Geheimnis zum Signieren der Login-Sessions (JWT).
# Zufaellig erzeugen, z. B.: openssl rand -hex 32
APP_SECRET=bitte-zufaellig-setzen

# Port des eingebauten Webservers (Standard: 3000)
# Interner Port des Containers (nach aussen: 3100, siehe docker-compose.yml)
# PORT=3000

# Ablageort fuer Patienten-Dokumente (Uploads)
# UPLOAD_DIR=./dokumente

# GEFAHR - NUR FUER LOKALE TESTS AUF DEM EIGENEN RECHNER:
# Ueberspringt den Login komplett (jeder Besucher ist Admin).
# Niemals auf einem oeffentlich erreichbaren Server setzen!
# LOCAL_AUTH_BYPASS=1
