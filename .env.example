# Dr.PaWaWi — Beispiel-Konfiguration
# Einrichtung:  cp .env.example .env   und alle Werte setzen.
# Docker Compose liest .env automatisch ein (die docker-compose.yml enthaelt
# absichtlich keine Secret-Werte). .env NIEMALS committen oder weitergeben!

# Pflicht: Root-Passwort des MySQL-Containers (db).
# Eigenen, zufaelligen Wert waehlen, z. B.: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=bitte-eigenes-passwort-setzen

# Pflicht: DB-Verbindung der App. Im Docker-Betrieb ist der Host "db" und
# das Passwort muss mit MYSQL_ROOT_PASSWORD uebereinstimmen:
#   mysql://root:<MYSQL_ROOT_PASSWORD>@db:3306/praxiswerk
# (Nur fuer Entwicklung ohne Docker: Host "localhost" verwenden.)
DATABASE_URL=mysql://root:bitte-eigenes-passwort-setzen@db:3306/praxiswerk

# Pflicht: Geheimnis zum Signieren der Login-Sessions (JWT).
# Zufaellig erzeugen, z. B.: openssl rand -hex 32
APP_SECRET=bitte-zufaellig-setzen

# Interner Port des App-Containers (nach aussen: 3100, siehe docker-compose.yml)
# PORT=3000

# Ablageort fuer Patienten-Dokumente (Uploads) — im Container gesetzt
# UPLOAD_DIR=/app/dokumente

# GEFAHR - NUR FUER LOKALE TESTS AUF DEM EIGENEN RECHNER:
# Ueberspringt den Login komplett (jeder Besucher ist Admin).
# Niemals auf einem oeffentlich erreichbaren Server setzen!
# LOCAL_AUTH_BYPASS=1
